# Raw evidence never enters Git: deny everything, then allow only the docs.
/docs/evidence/*
!/docs/evidence/.gitkeep
!/docs/evidence/README.md
!/docs/evidence/README.fr.md
# Packet and HTTP captures are never committed anywhere.
*.pcap
*.pcapng
*.har
*.etl
