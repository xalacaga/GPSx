+// GPSx: state reported through android_chiaki_audio_output_stats().
+enum AudioOutputState
+{
+	AUDIO_STATE_NONE = 0,
+	AUDIO_STATE_AAUDIO = 1,
+	AUDIO_STATE_FAILED = 2,
+	AUDIO_STATE_OPENSLES = 3,
+};
