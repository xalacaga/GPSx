+// Sleeps [ms] in short steps; false once the output closes or a newer task replaces [generation].
+static bool sleep_while_current(AudioOutput *ao, uint32_t generation, int ms)
+{
+	for(int waited = 0; waited < ms; waited += 50)
+	{
+		if(ao->closing || ao->generation.load() != generation)
+			return false;
+		std::this_thread::sleep_for(std::chrono::milliseconds(50));
+	}
+	return !ao->closing && ao->generation.load() == generation;
+}
+
+/**
+ * Task body: after [delay_ms], optionally reopens the stream ([retry_aaudio] lifts an earlier
+ * OpenSL ES fallback), then falls back to OpenSL ES when an AAudio stream never pulls audio.
+ */
+static void reopen_and_watch(AudioOutput *ao, uint32_t generation, int delay_ms, bool reopen, bool retry_aaudio)
+{
+	if(!sleep_while_current(ao, generation, delay_ms))
+		return;
+	uint32_t start;
+	{
+		std::lock_guard<std::mutex> lock(ao->mutex);
+		if(ao->closing || ao->generation.load() != generation)
+			return;
+		if(reopen)
+		{
+			if(retry_aaudio)
+				ao->force_opensles = false;
+			ao->stream = nullptr;
+			if(open_stream_locked(ao))
+				CHIAKI_LOGI(ao->log, "Audio Output reopened after route change");
+		}
+		if(ao->state.load() != AUDIO_STATE_AAUDIO)
+			return;
+		start = ao->callbacks.load();
+	}
+	if(!sleep_while_current(ao, generation, AUDIO_WATCHDOG_MS))
+		return;
+	std::lock_guard<std::mutex> lock(ao->mutex);
+	if(ao->closing || ao->generation.load() != generation)
+		return;
+	if(ao->state.load() != AUDIO_STATE_AAUDIO || ao->callbacks.load() != start)
+		return;
+	CHIAKI_LOGW(ao->log, "Audio Output: AAudio stream silent, switching to OpenSL ES");
+	ao->force_opensles = true;
+	ao->reopens++;
+	ao->stream = nullptr;
+	open_stream_locked(ao);
+}
+
+/**
+ * Replaces any pending task with a new reopen_and_watch() run.
+ * Must be called without holding ao->mutex. The previous task notices the new generation
+ * within 50 ms unless it is reopening the stream, so the join stays short.
+ */
+static void schedule_task(AudioOutput *ao, int delay_ms, bool reopen, bool retry_aaudio)
+{
+	uint32_t generation = ++ao->generation;
+	std::thread previous;
+	{
+		std::lock_guard<std::mutex> lock(ao->mutex);
+		previous = std::move(ao->reopen_thread);
+	}
+	// Join outside the lock: the previous task takes the same mutex.
+	if(previous.joinable())
+		previous.join();
+	std::lock_guard<std::mutex> lock(ao->mutex);
+	if(ao->closing || ao->generation.load() != generation)
+		return;
+	ao->reopen_thread = std::thread(reopen_and_watch, ao, generation, delay_ms, reopen, retry_aaudio);
+}
