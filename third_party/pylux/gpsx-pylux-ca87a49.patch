@@ -102,11 +102,36 @@ void android_chiaki_video_decoder_set_surface(AndroidChiakiVideoDecoder *decoder
 	AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_WIDTH, decoder->target_width);
 	AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_HEIGHT, decoder->target_height);
 
-	media_status_t r = AMediaCodec_configure(decoder->codec, format, decoder->window, NULL, 0);
+	// GPSx: low-latency decoding. "low-latency" is honoured from API 30 by decoders that support
+	// it; "priority" 0 asks for real-time scheduling; vendor keys cover Qualcomm, MediaTek and
+	// Exynos decoders. Unknown keys are normally ignored, and a refused configure is retried
+	// without them so video never depends on these hints.
+	AMediaFormat *low_latency_format = AMediaFormat_new();
+	AMediaFormat_setString(low_latency_format, AMEDIAFORMAT_KEY_MIME, mime);
+	AMediaFormat_setInt32(low_latency_format, AMEDIAFORMAT_KEY_WIDTH, decoder->target_width);
+	AMediaFormat_setInt32(low_latency_format, AMEDIAFORMAT_KEY_HEIGHT, decoder->target_height);
+	AMediaFormat_setInt32(low_latency_format, "low-latency", 1);
+	AMediaFormat_setInt32(low_latency_format, "priority", 0);
+	AMediaFormat_setInt32(low_latency_format, "vendor.qti-ext-dec-low-latency.enable", 1);
+	AMediaFormat_setInt32(low_latency_format, "vendor.rtc-ext-dec-low-latency.enable", 1);
+	AMediaFormat_setInt32(low_latency_format, "vendor.low-latency.enable", 1);
+	media_status_t r = AMediaCodec_configure(decoder->codec, low_latency_format, decoder->window, NULL, 0);
+	AMediaFormat_delete(low_latency_format);
+	if(r == AMEDIA_OK)
+		CHIAKI_LOGI(decoder->log, "AMediaCodec configured with low-latency hints");
+	else
+	{
+		CHIAKI_LOGW(decoder->log, "AMediaCodec refused low-latency hints (%d), retrying without", (int)r);
+		AMediaCodec_delete(decoder->codec);
+		decoder->codec = AMediaCodec_createDecoderByType(mime);
+		r = decoder->codec ? AMediaCodec_configure(decoder->codec, format, decoder->window, NULL, 0) : AMEDIA_ERROR_UNKNOWN;
+	}
 	if(r != AMEDIA_OK)
 	{
 		CHIAKI_LOGE(decoder->log, "AMediaCodec_configure() failed: %d", (int)r);
 		AMediaFormat_delete(format);
+		if(!decoder->codec)
+			goto error_surface;
 		goto error_codec;
 	}
 
