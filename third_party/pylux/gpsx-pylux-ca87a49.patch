 void AudioOutputCallback::onErrorAfterClose(oboe::AudioStream *stream, oboe::Result error)
 {
 	CHIAKI_LOGE(audio_output->log, "Oboe reported error after close: %s", oboe::convertToText(error));
+	// GPSx: a route change (Bluetooth speaker connected or reconnected) disconnects the stream.
+	// Reopen it on a separate thread; Oboe forbids reopening from the callback thread.
+	AudioOutput *ao = audio_output;
+	if(ao->closing)
+		return;
+	ao->state = AUDIO_STATE_FAILED;
+	std::thread previous;
+	{
+		std::lock_guard<std::mutex> lock(ao->mutex);
+		previous = std::move(ao->reopen_thread);
+	}
+	// Join outside the lock: the previous reopen thread takes the same mutex.
+	if(previous.joinable())
+		previous.join();
+	std::lock_guard<std::mutex> lock(ao->mutex);
+	if(ao->closing)
+		return;
+	ao->reopens++;
+	ao->reopen_thread = std::thread([ao]() {
+		// Let this callback return and the new audio route settle before replacing the stream.
+		std::this_thread::sleep_for(std::chrono::milliseconds(300));
+		std::lock_guard<std::mutex> reopen_lock(ao->mutex);
+		if(ao->closing)
+			return;
+		ao->stream = nullptr;
+		open_stream_locked(ao);
+	});
 }
