+// GPSx: shared mode works on every route (Bluetooth A2DP has no exclusive/MMAP path).
+// Tries AAudio (unless OpenSL ES is forced), then OpenSL ES; low latency first, then default.
+// Caller holds ao->mutex.
+static bool open_stream_locked(AudioOutput *ao)
+{
+	bool opensles_only = ao->force_opensles || g_audio_api_preference.load() == 1;
+	const oboe::AudioApi apis[] = { oboe::AudioApi::AAudio, oboe::AudioApi::OpenSLES };
+	const oboe::PerformanceMode modes[] = { oboe::PerformanceMode::LowLatency, oboe::PerformanceMode::None };
+	for(auto api : apis)
+	{
+		if(opensles_only && api == oboe::AudioApi::AAudio)
+			continue;
+		if(api == oboe::AudioApi::AAudio && !oboe::AudioStreamBuilder::isAAudioRecommended())
+			continue;
+		for(auto mode : modes)
+		{
+			oboe::AudioStreamBuilder builder;
+			builder.setAudioApi(api)
+				->setPerformanceMode(mode)
+				->setSharingMode(oboe::SharingMode::Shared)
+				->setUsage(oboe::Usage::Game)
+				->setContentType(oboe::ContentType::Music)
+				->setFormat(oboe::AudioFormat::I16)
+				->setChannelCount(ao->channels)
+				->setSampleRate(ao->rate)
+				->setSampleRateConversionQuality(oboe::SampleRateConversionQuality::Medium)
+				->setCallback(&ao->stream_callback);
+			oboe::Result result = builder.openManagedStream(ao->stream);
+			if(result == oboe::Result::OK)
+				result = ao->stream->requestStart();
+			if(result == oboe::Result::OK)
+			{
+				bool aaudio = ao->stream->getAudioApi() == oboe::AudioApi::AAudio;
+				CHIAKI_LOGI(ao->log, "Audio Output started Oboe stream (%s, %s, %d Hz, buffer %d frames)",
+					aaudio ? "AAudio" : "OpenSL ES",
+					mode == oboe::PerformanceMode::LowLatency ? "low latency" : "default",
+					ao->stream->getSampleRate(), ao->stream->getBufferSizeInFrames());
+				ao->state = aaudio ? AUDIO_STATE_AAUDIO : AUDIO_STATE_OPENSLES;
+				return true;
+			}
+			CHIAKI_LOGE(ao->log, "Audio Output failed to open/start Oboe stream: %s", oboe::convertToText(result));
+			ao->stream = nullptr;
+		}
+	}
+	ao->state = AUDIO_STATE_FAILED;
+	return false;
+}
+
+/**
+ * Replaces any pending reopen thread with [task] run after [delay_ms].
+ * Must be called without holding ao->mutex; the task takes it itself.
+ */
+template<typename Task>
+static void schedule_locked_task(AudioOutput *ao, int delay_ms, Task task)
+{
+	std::thread previous;
+	{
+		std::lock_guard<std::mutex> lock(ao->mutex);
+		previous = std::move(ao->reopen_thread);
+	}
+	// Join outside the lock: the previous task takes the same mutex.
+	if(previous.joinable())
+		previous.join();
+	std::lock_guard<std::mutex> lock(ao->mutex);
+	if(ao->closing)
+		return;
+	ao->reopen_thread = std::thread([ao, delay_ms, task]() {
+		std::this_thread::sleep_for(std::chrono::milliseconds(delay_ms));
+		std::lock_guard<std::mutex> task_lock(ao->mutex);
+		if(!ao->closing)
+			task();
+	});
+}
+
+/** Falls back to OpenSL ES when an AAudio stream never pulls audio. */
+static void schedule_watchdog(AudioOutput *ao)
+{
+	if(ao->state.load() != AUDIO_STATE_AAUDIO)
+		return;
+	uint32_t start = ao->callbacks.load();
+	schedule_locked_task(ao, AUDIO_WATCHDOG_MS, [ao, start]() {
+		if(ao->state.load() != AUDIO_STATE_AAUDIO || ao->callbacks.load() != start)
+			return;
+		CHIAKI_LOGW(ao->log, "Audio Output: AAudio stream silent, switching to OpenSL ES");
+		ao->force_opensles = true;
+		ao->reopens++;
+		ao->stream = nullptr;
+		open_stream_locked(ao);
+	});
+}
+
+extern "C" void android_chiaki_audio_output_set_api_preference(int preference)
+{
+	g_audio_api_preference = preference == 1 ? 1 : 0;
+}
