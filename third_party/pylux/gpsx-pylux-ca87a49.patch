 struct AudioOutput
 {
 	ChiakiLog *log;
+	std::mutex mutex; // guards stream, channels, rate, force_opensles and reopen_thread
 	oboe::ManagedStream stream;
 	AudioOutputCallback stream_callback;
 	AudioBuffer buf;
