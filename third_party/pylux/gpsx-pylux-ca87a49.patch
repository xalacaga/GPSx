+	ao->reopens++;
+	// Give the new route (Bluetooth A2DP takes a moment) a fresh AAudio attempt, watchdog included.
+	schedule_task(ao, 500, true, g_audio_api_preference.load() != 1);
+}
+
+extern "C" void android_chiaki_audio_output_set_api_preference(int preference)
