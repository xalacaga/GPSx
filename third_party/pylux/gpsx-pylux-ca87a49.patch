+extern "C" void android_chiaki_audio_output_restart(void *audio_output)
+{
+	auto ao = reinterpret_cast<AudioOutput *>(audio_output);
+	if(!ao || ao->closing)
+		return;
+	{
+		std::lock_guard<std::mutex> lock(ao->mutex);
+		if(ao->rate == 0)
